<style>
  .mark {
    display: block;
    width: auto;
    /* inherits the ink of whatever it sits in, so it inverts with its host */
    fill: currentColor;
    /* the pen is a little thin at this size, so the outline is stroked in the
       same ink to put half a pixel back on every stem — non-scaling, so it
       stays half a pixel whatever height the mark is drawn at */
    stroke: currentColor;
    stroke-width: 0.5;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    flex: 0 0 auto;
  }
</style>
