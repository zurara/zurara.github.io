---
/**
 * The wordmark: "zurara" written in Nanum Pen Script, kept as an outline
 * rather than as text.
 *
 * Six letters are not worth a third webfont — this face is a 3MB Korean font
 * upstream — and a drawn mark can never reflow, fall back to a different
 * hand, or arrive late. The path is the font's own glyphs, converted once
 * with fontTools and rounded to font units (at this size one unit is about
 * 0.02px, so the rounding is invisible).
 *
 * The viewBox is the ink's own bounding box, so `height` IS the height of the
 * written letters — no leading to subtract when lining it up with anything.
 * Both places the mark appears size it the same way, which is what keeps the
 * home page and TopNav on the same pixel.
 */
interface Props {
  /** height of the written letters, in px */
  height?: number;
  /** an accessible name, unless a parent link already carries one */
  label?: string;
}
const { height = 12, label } = Astro.props;
---

