---
// The site's one top nav — the bar the /minimap page introduced, extracted so
// every scrolling page wears the same chrome: wordmark on the left, an
// OPTIONAL call to action on the right. Pages that have nothing to offer just
// render the wordmark, and the bar's height and type never drift between pages.
//
// The conveyor home is deliberately NOT a consumer: it has no scroll, and its
// own fixed chrome is part of the card-table illusion.
interface Cta {
  label: string;
  href: string;
  /** small muted note trailing the label, e.g. a file size */
  note?: string;
  /** id of a sprite <symbol> already present on the page, e.g. 'd-download' */
  icon?: string;
  download?: boolean;
  external?: boolean;
}
import { ringPath } from '../lib/ring';

// the ring is drawn in this box and stretched to the button; the stroke stays
// even because it is painted with vector-effect: non-scaling-stroke
const RW = 160;
const RH = 44;

interface Props {
  backHref?: string;
  backLabel?: string;
  cta?: Cta;
  /** a quieter link sitting left of the CTA — a repo link, a star count. Its
      note is always rendered (empty until something fills it), so a page can
      update the number client-side without the bar reflowing. */
  secondary?: Cta;
  /** draw the CTA's outline by hand instead of ruling it. Opt-in, because it
      needs the page to define the #rough-* filters — only /minimap does. */
  rough?: boolean;
}
const { backHref = '/', backLabel = 'zurara', cta, secondary, rough } = Astro.props;
---

<header class="top">
  <a class="back" href={backHref}>{backLabel}</a>
  {
    (cta || secondary) && (
      <nav>
        {/* aria-label, because the label below is hidden on narrow screens and
            the icon alone would leave the link with no accessible name */}
        {secondary && (
          <a
            class="btn ghost"
            data-cta="secondary"
            aria-label={secondary.label}
            href={secondary.href}
            target={secondary.external ? '_blank' : undefined}
            rel={secondary.external ? 'noopener' : undefined}
          >
            {secondary.icon && (
              <svg class="i" aria-hidden="true">
                <use href={`#${secondary.icon}`} />
              </svg>
            )}
            <span class="btn-label">{secondary.label}</span>
            <span class="btn-sz" data-cta-note>
              {secondary.note}
            </span>
          </a>
        )}
        {cta && (
        <a
          class="btn"
          data-rough={rough ? '' : undefined}
          href={cta.href}
          download={cta.download}
          target={cta.external ? '_blank' : undefined}
          rel={cta.external ? 'noopener' : undefined}
        >
          {rough && (
            <svg
              class="btn-ring"
              viewBox={`0 0 ${RW} ${RH}`}
              preserveAspectRatio="none"
              aria-hidden="true"
            >
              <path d={ringPath(cta.label, RW, RH)} pathLength="1" />
            </svg>
          )}
          {cta.icon && (
            <svg class="i" aria-hidden="true">
              <use href={`#${cta.icon}`} />
            </svg>
          )}
          {cta.label}
          {cta.note && <span class="btn-sz">{cta.note}</span>}
        </a>
        )}
      </nav>
    )
  }
</header>

<style>
  .top {
    position: sticky;
    top: 0;
    z-index: 10;
    /* the shell may centre its children (ArticleLayout does) — the bar never
       shrinks to its contents */
    width: 100%;
    align-self: stretch;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    /* The wordmark must land on exactly the same pixel as the home page's
       fixed chrome, so navigating never nudges it: 28px from the left, and a
       64px bar centres a 12px line at y=32 — the same as .cv-tl's top:26px.
       Height stays fixed whether or not the page has a CTA. */
    min-height: 64px;
    padding: 0 28px;
    background: color-mix(in srgb, var(--paper, #fff) 86%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--rule, #ececec);
  }
  .top a {
    color: inherit;
    text-decoration: none;
  }
  /* same wordmark as the home page: written by hand, not set in type. Gochi
     Hand ships one weight only, so 400 and never lighter; a handwriting face
     also wants no tracking and no uppercasing. */
  .back {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-display);
    font-size: 19px;
    line-height: 1;
    font-weight: 400;
    letter-spacing: 0.01em;
    color: var(--ink, #0a0a0a);
  }
  .back:hover {
    color: var(--ink-2, #6a6a6a);
  }
  .top nav {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 15px;
    border: 1px solid var(--rule-2, #0a0a0a);
    border-radius: 999px;
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
    transition:
      border-color 0.15s,
      background 0.15s,
      transform 0.15s;
  }
  /* the weight rides in the button so the page need not say it twice */
  .btn-sz {
    color: var(--ink-3, #9a9a9a);
    font-size: 12px;
    letter-spacing: 0.02em;
  }
  .btn:hover .btn-sz {
    color: inherit;
    opacity: 0.6;
  }
  .btn:hover {
    border-color: var(--ink, #0a0a0a);
    transform: translateY(-1px);
  }
  /* the drawn outline: the ruled border steps aside and the stroke is laid
     over the top, where the header's own background cannot bury it */
  .btn[data-rough],
  .btn[data-rough]:hover {
    position: relative;
    border-color: transparent;
    /* hovering goes over the line again rather than lifting the button */
    transform: none;
  }
  .btn[data-rough]::after {
    content: '';
    position: absolute;
    inset: 0;
    border: 1.5px solid currentColor;
    border-radius: 999px;
    filter: url(#rough-b);
    pointer-events: none;
  }
  /* hovering rings the button by hand — one pass of the pen, the same gesture
     the 404 uses on its way back home. The button never moves. */
  .btn-ring {
    position: absolute;
    /* the download pill is wide enough for a loose loop to clear its words;
       this button is not, so its ring sits closer in — the same hand, drawn
       to the size of what it is circling */
    inset: -4px -6px;
    overflow: visible;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    pointer-events: none;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 0.42s cubic-bezier(0.3, 0.7, 0.3, 1);
  }
  .btn[data-rough]:hover .btn-ring,
  .btn[data-rough]:focus-visible .btn-ring {
    stroke-dashoffset: 0;
  }
  /* the secondary never competes with the CTA: no outline until hover */
  .btn.ghost {
    padding: 9px 12px;
    border-color: transparent;
    color: var(--ink-2, #6a6a6a);
  }
  .btn.ghost:hover {
    color: var(--ink, #0a0a0a);
    border-color: var(--rule, #ececec);
  }
  /* a count that has not arrived yet must not leave a gap behind it */
  .btn-sz:empty {
    display: none;
  }
  .top .i {
    width: 18px;
    height: 18px;
    fill: currentColor;
    flex: 0 0 auto;
  }

  /* same breakpoint as the home conveyor, so both switch together */
  @media (max-width: 640px) {
    .top {
      min-height: 47px; /* centres an 11px line at y=23.5, matching .cv-tl */
      padding: 0 18px;
    }
    .back {
      font-size: 17px;
    }
    .btn {
      padding: 7px 13px;
      font-size: 13px;
    }
    /* two buttons do not fit next to the wordmark: the secondary keeps its
       icon and its number, and drops the word */
    .btn.ghost {
      padding: 7px 9px;
    }
    .btn.ghost .btn-label {
      display: none;
    }
  }
</style>
