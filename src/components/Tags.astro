---
// A tag is a word in the handwriting face with a single pen stroke circled
// round it — one continuous line, overshooting where it closes, the way you
// actually ring a word on paper.
//
// The ring itself lives in `lib/ring.ts` (the 404 rings its number with the
// same hand); it is generated at build time from a seed made of the label, so
// a tag's wobble is stable across loads but no two tags are ringed alike.
import { ringPath } from '../lib/ring';

interface Props {
  tags: string[];
  label?: string;
}
const { tags, label = 'Tags' } = Astro.props;

// drawn in this box and stretched to the chip — the stroke stays even because
// the path is painted with vector-effect: non-scaling-stroke
const W = 100;
const H = 44;
---

<ul class="tags" aria-label={label}>
  {
    tags.map((t) => (
      <li>
        <svg class="ring" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true">
          <path d={ringPath(t, W, H)} />
        </svg>
        <span>{t}</span>
      </li>
    ))
  }
</ul>

<style>
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .tags li {
    position: relative;
    /* a short label like "UI" would otherwise get a ring half the size of its
       neighbours — every ring gets at least this much to go round */
    min-width: 72px;
    text-align: center;
    padding: 3px 10px 4px;
    font-family: var(--font-display);
    font-weight: 400;
    /* set at the prose subheading size — same face, same scale */
    font-size: 22px;
    line-height: 1.1;
    white-space: nowrap;
  }
  /* the ring needs room to overshoot the word it circles */
  .ring {
    position: absolute;
    inset: -2px -4px;
    overflow: visible;
    fill: none;
    stroke: var(--line, #0a0a0a);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    pointer-events: none;
  }

  @media (max-width: 640px) {
    .tags li {
      font-size: 19px;
    }
  }
</style>
