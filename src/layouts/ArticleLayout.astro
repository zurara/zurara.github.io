---
import TopNav from '../components/TopNav.astro';
import Fonts from '../components/Fonts.astro';

interface Props {
  title?: string;
  description?: string;
  /** optional call to action in the top bar — see components/TopNav.astro */
  cta?: {
    label: string;
    href: string;
    note?: string;
    icon?: string;
    download?: boolean;
    external?: boolean;
  };
}

const {
  title = 'zurara',
  description = '',
  cta,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonical} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Fonts />

    <style is:global>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }
      :root {
        --ink: #0a0a0a;
        --paper: #ffffff;
        --muted: #6a6a6a;
        --line: #0a0a0a;
        --measure: 680px;
      }
      html {
        scroll-behavior: smooth;
      }
      html,
      body {
        margin: 0;
        width: 100%;
        overflow-x: hidden; /* nothing can shift the centered column sideways */
        background: var(--paper);
        color: var(--ink);
        font-family: var(--font-body);
        font-size: 18px;
        line-height: 1.7;
        -webkit-font-smoothing: antialiased;
      }
      /* center the column via flex — immune to any margin:auto edge cases */
      body {
        display: flex;
        flex-direction: column;
        align-items: center;
        min-height: 100vh;
      }
      a {
        color: inherit;
      }

      /* ---- fixed minimal chrome ---- */
      /* ---- article column ---- */
      .detail {
        width: 100%;
        max-width: var(--measure);
        margin: 0 auto;
        padding: 72px 28px 140px;
      }
      .detail-head {
        margin-bottom: 40px;
      }
      /* kicker and date sit on ONE line, set identically — they are the same
         kind of information, so they read as one label */
      .detail-eyebrow {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 10px;
        margin-bottom: 18px;
        /* set exactly like the card kicker on the home conveyor (.cv-kind):
           11px, light, widely tracked caps */
        font-size: 11px;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        font-weight: 300;
      }
      .detail-eyebrow .sep {
        opacity: 0.35;
      }
      .detail-kind,
      .post-date,
      .work-year,
      .work-kind {
        font: inherit;
        letter-spacing: inherit;
        color: inherit;
      }
      .detail-title {
        font-family: var(--font-display);
        font-weight: 400;
        font-size: clamp(34px, 6vw, 56px);
        line-height: 1.06;
        margin: 0 0 22px;
      }
      .detail-summary {
        /* the lede reads at body size — it is set apart by colour, not scale */
        font-size: 18px;
        line-height: 1.7;
        color: #333;
        margin: 0 0 22px;
      }
      /* tag chips live in components/Tags.astro */

      /* cover — kept monochrome to match the index */
      .detail-media {
        margin: 0 0 48px;
      }
      .detail-media img {
        width: 100%;
        height: auto;
        display: block;
        filter: grayscale(1) contrast(1.02);
        border: 1px solid var(--line);
      }
      .work-card-fill {
        display: block;
        width: 100%;
        aspect-ratio: 16 / 10;
        border: 1px solid var(--line);
        background:
          repeating-linear-gradient(
            45deg,
            #f3f3f3,
            #f3f3f3 10px,
            #ececec 10px,
            #ececec 20px
          );
      }

      /* ---- prose (MDX body) ---- */
      .prose {
        font-size: 18px;
        overflow-wrap: break-word; /* long URLs/strings can't force overflow */
      }
      .prose :is(img, pre, table, iframe, video, figure) {
        max-width: 100%;
      }
      .prose > * + * {
        margin-top: 1.25em;
      }
      .prose h2,
      .prose h3,
      .prose h4 {
        font-family: var(--font-display);
        font-weight: 400;
        line-height: 1.25;
        margin-top: 1.9em;
      }
      .prose h2 {
        font-size: 28px;
      }
      .prose h3 {
        font-size: 22px;
      }
      .prose a {
        color: var(--ink);
        text-underline-offset: 3px;
        text-decoration-thickness: 1px;
      }
      .prose a:hover {
        text-decoration: none;
      }
      .prose strong {
        font-weight: 600;
      }
      .prose blockquote {
        margin: 1.6em 0;
        padding-left: 22px;
        border-left: 2px solid var(--ink);
        font-family: var(--font-display);
        font-style: normal;
        font-size: 21px;
        color: #222;
      }
      /* hand-inked list markers: the bullets are little pen blobs (three of
         them, cycled, so no two in a row match) and the numbers are written in
         the display hand rather than set in the body face */
      .prose ul,
      .prose ol {
        list-style: none;
        padding-left: 1.6em;
      }
      .prose li {
        position: relative;
      }
      .prose ul > li::before {
        content: '';
        position: absolute;
        /* every mark hangs from the same axis — the hand is in the shape of
           the mark, not in where it lands */
        left: -1.25em;
        top: 0.62em;
        width: 8px;
        height: 8px;
        /* the blob is a MASK, so the colour lives in CSS, not in the data URI */
        background: var(--mark, #ff7a1a);
        -webkit-mask: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12'><path d='M10.82 7.12C10.72 7.58 10.00 8.09 9.48 8.29C8.97 8.49 8.14 8.16 7.72 8.32C7.30 8.48 7.29 8.93 6.97 9.25C6.64 9.57 6.22 10.08 5.77 10.23C5.31 10.38 4.67 10.35 4.25 10.15C3.82 9.95 3.53 9.40 3.21 9.03C2.89 8.65 2.48 8.33 2.33 7.90C2.19 7.47 2.24 6.90 2.33 6.47C2.43 6.03 2.78 5.69 2.88 5.28C2.99 4.87 2.92 4.53 2.96 4.00C2.99 3.47 2.82 2.51 3.10 2.09C3.38 1.66 4.12 1.44 4.64 1.44C5.16 1.45 5.75 1.92 6.22 2.13C6.68 2.33 7.02 2.48 7.41 2.67C7.79 2.85 8.20 2.98 8.55 3.24C8.90 3.49 9.25 3.81 9.51 4.18C9.76 4.56 9.85 4.99 10.07 5.48C10.29 5.97 10.92 6.65 10.82 7.12Z' fill='%23000'/></svg>") no-repeat center / contain;
        mask: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12'><path d='M10.82 7.12C10.72 7.58 10.00 8.09 9.48 8.29C8.97 8.49 8.14 8.16 7.72 8.32C7.30 8.48 7.29 8.93 6.97 9.25C6.64 9.57 6.22 10.08 5.77 10.23C5.31 10.38 4.67 10.35 4.25 10.15C3.82 9.95 3.53 9.40 3.21 9.03C2.89 8.65 2.48 8.33 2.33 7.90C2.19 7.47 2.24 6.90 2.33 6.47C2.43 6.03 2.78 5.69 2.88 5.28C2.99 4.87 2.92 4.53 2.96 4.00C2.99 3.47 2.82 2.51 3.10 2.09C3.38 1.66 4.12 1.44 4.64 1.44C5.16 1.45 5.75 1.92 6.22 2.13C6.68 2.33 7.02 2.48 7.41 2.67C7.79 2.85 8.20 2.98 8.55 3.24C8.90 3.49 9.25 3.81 9.51 4.18C9.76 4.56 9.85 4.99 10.07 5.48C10.29 5.97 10.92 6.65 10.82 7.12Z' fill='%23000'/></svg>") no-repeat center / contain;
      }
      .prose ul > li:nth-child(3n + 2)::before {
        -webkit-mask-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12'><path d='M5.90 8.96C5.46 8.90 5.06 9.47 4.61 9.51C4.16 9.55 3.56 9.45 3.19 9.19C2.82 8.94 2.59 8.41 2.38 7.97C2.17 7.54 1.98 7.06 1.91 6.59C1.85 6.12 1.77 5.53 1.98 5.13C2.18 4.72 2.78 4.42 3.15 4.18C3.53 3.94 3.95 4.00 4.23 3.68C4.51 3.37 4.50 2.72 4.83 2.29C5.15 1.85 5.71 1.12 6.17 1.07C6.63 1.02 7.22 1.61 7.59 1.98C7.96 2.35 8.14 2.90 8.39 3.29C8.63 3.68 8.89 3.97 9.05 4.34C9.22 4.71 9.33 5.11 9.39 5.51C9.45 5.91 9.35 6.26 9.41 6.74C9.46 7.22 9.80 7.86 9.73 8.39C9.65 8.91 9.37 9.63 8.95 9.87C8.53 10.12 7.72 9.99 7.21 9.84C6.70 9.68 6.33 9.01 5.90 8.96Z' fill='%23000'/></svg>");
        mask-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12'><path d='M5.90 8.96C5.46 8.90 5.06 9.47 4.61 9.51C4.16 9.55 3.56 9.45 3.19 9.19C2.82 8.94 2.59 8.41 2.38 7.97C2.17 7.54 1.98 7.06 1.91 6.59C1.85 6.12 1.77 5.53 1.98 5.13C2.18 4.72 2.78 4.42 3.15 4.18C3.53 3.94 3.95 4.00 4.23 3.68C4.51 3.37 4.50 2.72 4.83 2.29C5.15 1.85 5.71 1.12 6.17 1.07C6.63 1.02 7.22 1.61 7.59 1.98C7.96 2.35 8.14 2.90 8.39 3.29C8.63 3.68 8.89 3.97 9.05 4.34C9.22 4.71 9.33 5.11 9.39 5.51C9.45 5.91 9.35 6.26 9.41 6.74C9.46 7.22 9.80 7.86 9.73 8.39C9.65 8.91 9.37 9.63 8.95 9.87C8.53 10.12 7.72 9.99 7.21 9.84C6.70 9.68 6.33 9.01 5.90 8.96Z' fill='%23000'/></svg>");
      }
      .prose ul > li:nth-child(3n)::before {
        -webkit-mask-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12'><path d='M8.24 8.66C7.71 8.79 7.46 8.85 7.07 9.11C6.67 9.38 6.32 10.08 5.88 10.26C5.43 10.43 4.85 10.28 4.37 10.15C3.89 10.03 3.42 9.79 3.00 9.51C2.59 9.22 2.10 8.88 1.90 8.44C1.70 8.00 1.67 7.35 1.79 6.87C1.91 6.38 2.40 5.93 2.62 5.52C2.83 5.11 3.00 4.90 3.08 4.40C3.15 3.90 2.85 3.05 3.06 2.51C3.27 1.97 3.83 1.28 4.34 1.17C4.85 1.05 5.62 1.59 6.12 1.82C6.62 2.05 6.96 2.33 7.36 2.54C7.76 2.74 8.20 2.80 8.52 3.05C8.83 3.31 9.03 3.71 9.25 4.07C9.47 4.43 9.54 4.77 9.83 5.21C10.12 5.65 10.92 6.19 10.99 6.71C11.06 7.23 10.70 8.00 10.24 8.32C9.78 8.65 8.77 8.53 8.24 8.66Z' fill='%23000'/></svg>");
        mask-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12'><path d='M8.24 8.66C7.71 8.79 7.46 8.85 7.07 9.11C6.67 9.38 6.32 10.08 5.88 10.26C5.43 10.43 4.85 10.28 4.37 10.15C3.89 10.03 3.42 9.79 3.00 9.51C2.59 9.22 2.10 8.88 1.90 8.44C1.70 8.00 1.67 7.35 1.79 6.87C1.91 6.38 2.40 5.93 2.62 5.52C2.83 5.11 3.00 4.90 3.08 4.40C3.15 3.90 2.85 3.05 3.06 2.51C3.27 1.97 3.83 1.28 4.34 1.17C4.85 1.05 5.62 1.59 6.12 1.82C6.62 2.05 6.96 2.33 7.36 2.54C7.76 2.74 8.20 2.80 8.52 3.05C8.83 3.31 9.03 3.71 9.25 4.07C9.47 4.43 9.54 4.77 9.83 5.21C10.12 5.65 10.92 6.19 10.99 6.71C11.06 7.23 10.70 8.00 10.24 8.32C9.78 8.65 8.77 8.53 8.24 8.66Z' fill='%23000'/></svg>");
      }
      .prose ol {
        counter-reset: hand-item;
      }
      .prose ol > li::before {
        counter-increment: hand-item;
        content: counter(hand-item) '.';
        position: absolute;
        left: -1.7em;
        top: -0.06em;
        width: 1.2em;
        text-align: right;
        color: var(--mark, #ff7a1a);
        font-family: var(--font-display);
        font-weight: 400;
        font-size: 1.1em;
        line-height: inherit;
      }
      .prose li + li {
        margin-top: 0.4em;
      }
      .prose img {
        width: 100%;
        height: auto;
        filter: grayscale(1);
        border: 1px solid var(--line);
      }
      .prose code {
        font-family: var(--font-mono);
        font-size: 0.88em;
        background: #f2f2f2;
        padding: 0.12em 0.4em;
        border-radius: 2px;
      }
      .prose pre {
        background: #0a0a0a;
        color: #f5f5f5;
        padding: 18px 20px;
        overflow-x: auto;
        font-size: 14px;
        line-height: 1.55;
      }
      .prose pre code {
        background: none;
        padding: 0;
        color: inherit;
      }
      .prose hr {
        border: none;
        border-top: 1px solid var(--line);
        margin: 2.4em 0;
      }

      .detail-foot {
        width: 100%;
        max-width: var(--measure);
        margin: 0 auto;
        padding: 0 28px 90px;
        border-top: 1px solid var(--line);
      }
      /* set like the wordmark: light, tracked, uppercase, never underlined */
      .detail-foot .back-link {
        display: inline-block;
        padding-top: 28px;
        font-size: 12px;
        font-weight: 300;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        text-decoration: none;
        transition: opacity 0.2s ease;
      }
      .detail-foot .back-link:hover {
        opacity: 0.55;
      }

      /* ---- highlighter: drag across the text to mark it -----------------
         The one splash of colour on the whole site. Marks are painted on a
         fixed canvas overlay (multiply-blended so text stays crisp under
         the ink); dragging is handled in the script below. */
      .detail {
        user-select: none;
        -webkit-user-select: none;
        -webkit-touch-callout: none;
        cursor:
          url('/cursors/pen.svg') 1 23,
          text;
      }
      .detail a {
        cursor: inherit;
      }
      #hl-canvas {
        position: fixed;
        inset: 0;
        width: 100vw;
        height: 100vh;
        pointer-events: none;
        z-index: 5;
        mix-blend-mode: multiply;
      }
      @media (max-width: 640px) {
        body {
          font-size: 17px;
        }
        .detail {
          padding: 48px 20px 80px;
        }
        .detail-head {
          margin-bottom: 32px;
        }
        .detail-summary {
          font-size: 17px;
        }
        .prose {
          font-size: 17px;
        }
        .prose h2 {
          font-size: 24px;
        }
        .prose h3 {
          font-size: 20px;
        }
        .prose blockquote {
          font-size: 19px;
        }
        .detail-foot {
          padding: 0 20px 72px;
        }
        .detail-foot .back-link {
          font-size: 11px;
          letter-spacing: 0.06em;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
      }
    </style>
  </head>
  <body>
    <TopNav cta={cta} />
    <slot />

    <script>
      // highlighter — drag across article text to mark it, like a real
      // fluorescent marker. Marks live as DOM Ranges and are repainted from
      // their current client rects, so they follow the text through scrolls
      // and resizes. Fresh page every visit — nothing is stored.
      // the whole article column is markable — head (kicker, date, title,
      // summary, tags) as well as the MDX body
      const zone = document.querySelector<HTMLElement>('.detail');
      if (zone) {
        const canvas = document.createElement('canvas');
        canvas.id = 'hl-canvas';
        document.body.appendChild(canvas);
        const ctx = canvas.getContext('2d')!;

        const dpr = Math.min(window.devicePixelRatio || 1, 2);

        // seeded rng: a stroke's wobble must survive repaints unchanged
        const mulberry = (a: number) => () => {
          a |= 0;
          a = (a + 0x6d2b79f5) | 0;
          let t = Math.imul(a ^ (a >>> 15), 1 | a);
          t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
          return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
        };

        type Caret = { node: Node; offset: number };
        type Stroke = { a: Caret; range: Range | null; seed: number };
        const strokes: Stroke[] = [];
        let active: Stroke | null = null;

        const caretAt = (x: number, y: number): Caret | null => {
          const doc = document as any;
          if (doc.caretPositionFromPoint) {
            const p = doc.caretPositionFromPoint(x, y);
            return p ? { node: p.offsetNode, offset: p.offset } : null;
          }
          if (doc.caretRangeFromPoint) {
            const r = doc.caretRangeFromPoint(x, y);
            return r ? { node: r.startContainer, offset: r.startOffset } : null;
          }
          return null;
        };
        const inZone = (n: Node | null) =>
          !!n && zone.contains(n.nodeType === 3 ? n.parentNode : (n as Element));

        const buildRange = (a: Caret, b: Caret) => {
          const r = document.createRange();
          try {
            r.setStart(a.node, a.offset);
            r.setEnd(b.node, b.offset);
            if (r.collapsed) {
              r.setStart(b.node, b.offset);
              r.setEnd(a.node, a.offset);
            }
          } catch {
            return null;
          }
          return r.collapsed ? null : r;
        };

        // merge a range's client rects into per-line bands — seamless ink
        const bands = (range: Range) => {
          const out: { top: number; height: number; left: number; right: number }[] = [];
          for (const r of range.getClientRects()) {
            if (r.width < 2 || r.height < 6) continue;
            const prev = out[out.length - 1];
            if (prev && Math.abs(prev.top - r.top) < 4) {
              prev.left = Math.min(prev.left, r.left);
              prev.right = Math.max(prev.right, r.right);
            } else {
              out.push({ top: r.top, height: r.height, left: r.left, right: r.right });
            }
          }
          return out;
        };

        const paintStroke = (s: Stroke) => {
          const rnd = mulberry(s.seed);
          for (const b of bands(s.range!)) {
            // A wave ruled under the line, in ONE pass, DRAWN OUT: every
            // term below depends on how far the pen has travelled from where
            // it started — never on where the stroke ends. So the part already
            // laid down never reshapes as the drag grows; the line simply
            // gets longer, the way a pen draws rather than a rubber band
            // stretches. Nothing is regular: the baseline wanders, the wave
            // stretches and tightens as it goes, its height breathes, and a
            // fine tremble sits on top.
            const x0 = b.left - (2 + rnd() * 5);
            const x1 = b.right + (2 + rnd() * 5);
            const base = b.top + b.height * 0.9 + (rnd() * 1.6 - 0.8);
            const amp = Math.max(1.5, Math.min(3, b.height * 0.11));
            const len = Math.max(9, b.height * 0.62); // nominal wavelength
            const phase = rnd() * Math.PI * 2;
            // the hand wanders off the ruled line and back, twice over
            const sag1 = (rnd() * 2 - 1) * 1.3;
            const sag2 = (rnd() * 2 - 1) * 0.9;
            // …and its rhythm drifts: wavelength and height both breathe
            const lenDrift = 0.18 + rnd() * 0.3;
            const ampDrift = 0.2 + rnd() * 0.35;
            const w1 = rnd() * Math.PI * 2;
            const w2 = rnd() * Math.PI * 2;
            const w3 = rnd() * Math.PI * 2;

            ctx.globalAlpha = 0.92;
            ctx.lineWidth = 2.3 + rnd() * 0.7;
            let ph = phase;
            ctx.beginPath();
            const step = 1.6;
            for (let x = x0, first = true; x <= x1; x += step, first = false) {
              const u = (x - x0) / 90; // distance travelled, in slow cycles
              const L = len * (1 + lenDrift * Math.sin(u * 2.1 + w1));
              const A = amp * (1 + ampDrift * Math.sin(u * 3.3 + w2));
              if (!first) ph += (step / L) * Math.PI * 2;
              // a fine tremble on top of everything, stable per x
              const shake = Math.sin(x * 0.7 + w3) * 0.22 + Math.sin(x * 1.9 + w1) * 0.13;
              const drift = sag1 * Math.sin(u * 0.9 + w3) + sag2 * Math.sin(u * 0.37 + w2);
              const y = base + drift + shake + Math.sin(ph) * A;
              if (first) ctx.moveTo(x, y);
              else ctx.lineTo(x, y);
            }
            ctx.stroke();
          }
        };

        let queued = false;
        const draw = () => {
          queued = false;
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          ctx.clearRect(0, 0, canvas.width, canvas.height);
          ctx.strokeStyle = '#ff7a1a'; // marker orange — the site's one colour
          ctx.lineCap = 'round';
          ctx.lineJoin = 'round';
          for (const s of strokes) paintStroke(s);
          if (active?.range) paintStroke(active);
          ctx.globalAlpha = 1;
        };
        const schedule = () => {
          if (queued) return;
          queued = true;
          requestAnimationFrame(draw);
        };
        const size = () => {
          canvas.width = window.innerWidth * dpr;
          canvas.height = window.innerHeight * dpr;
          schedule();
        };

        const begin = (x: number, y: number) => {
          const c = caretAt(x, y);
          if (!c || !inZone(c.node)) return false;
          active = { a: c, range: null, seed: (Math.random() * 1e9) | 0 };
          return true;
        };
        const extend = (x: number, y: number) => {
          if (!active) return;
          const c = caretAt(x, y);
          if (!c || !inZone(c.node)) return;
          const r = buildRange(active.a, c);
          if (r) {
            active.range = r;
            schedule();
          }
        };

        // desktop: press & drag. touch: long-press first — a plain drag scrolls
        let lpTimer = 0;
        let lpFrom: { x: number; y: number } | null = null;
        let touchInk = false;
        zone.addEventListener('pointerdown', (e) => {
          if (e.pointerType === 'touch') {
            lpFrom = { x: e.clientX, y: e.clientY };
            lpTimer = window.setTimeout(() => {
              touchInk = begin(lpFrom!.x, lpFrom!.y);
              if (touchInk) navigator.vibrate?.(8);
            }, 380);
            return;
          }
          if (e.button !== 0) return;
          if (begin(e.clientX, e.clientY)) e.preventDefault();
        });
        window.addEventListener('pointermove', (e) => {
          if (e.pointerType === 'touch') {
            if (lpFrom && !touchInk && Math.hypot(e.clientX - lpFrom.x, e.clientY - lpFrom.y) > 10) {
              clearTimeout(lpTimer);
              lpFrom = null; // it's a scroll, not a highlight
            }
            if (!touchInk) return;
          }
          extend(e.clientX, e.clientY);
        });
        const finish = () => {
          clearTimeout(lpTimer);
          lpFrom = null;
          touchInk = false;
          if (active) {
            if (active.range) strokes.push(active);
            active = null;
            schedule();
          }
        };
        window.addEventListener('pointerup', finish);
        window.addEventListener('pointercancel', finish);
        // while inking on touch, the page must not scroll under the marker
        document.addEventListener(
          'touchmove',
          (e) => {
            if (touchInk) e.preventDefault();
          },
          { passive: false }
        );

        window.addEventListener('scroll', schedule, { passive: true });
        window.addEventListener('resize', size);
        size();
      }
    </script>
  </body>
</html>
