---
import Fonts from '../components/Fonts.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'zurara — selected work',
  description = 'zurara — designer at Orthogonal. Selected projects and writing.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Fonts />

    <style is:global>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }
      html,
      body {
        height: 100%;
        margin: 0;
        /* fixed height — the page itself never scrolls */
        overflow: hidden;
        background: #ffffff;
        color: #0a0a0a;
        font-family: var(--font-body);
        -webkit-font-smoothing: antialiased;
        /* the home is drawing paper — drags draw, they never select text */
        user-select: none;
        -webkit-user-select: none;
        /* one finger draws, two fingers scroll — the browser never pans/zooms */
        touch-action: none;
        overscroll-behavior: none;
      }
      a {
        color: inherit;
        text-decoration: none;
      }
      .skip-link {
        position: fixed;
        left: -9999px;
        top: 0;
      }
      .skip-link:focus {
        left: 12px;
        top: 12px;
        z-index: 100;
        background: #0a0a0a;
        color: #fff;
        padding: 8px 12px;
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#cards">Skip to work</a>
    <slot />
  </body>
</html>
