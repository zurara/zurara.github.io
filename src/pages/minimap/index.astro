    <header class="top">
      <a class="back" href="/">zurara</a>
      <nav>
        <a class="btn" href="/minimap/mindmap.zip" download
          ><svg class="i" aria-hidden="true"><use href="#d-download" /></svg>Download<span
            class="btn-sz">{zipKB} KB</span
          ></a
        >
      </nav>
    </header>

    <main>
      <section class="hero">
        <h1>Minimap <em>is minimal mind mapping</em></h1>
        <p class="lede">A mindmap tool can't get any lighter — it's just an HTML file.</p>
      </section>

      <section class="bento" aria-label="Features">
        <a
          class="shot"
          href="/minimap/mindmap.html"
          target="_blank"
          rel="noopener"
          aria-label="Open the mindmap tool in a new tab"
        >
          <span class="shot-bar"><i></i><i></i><i></i></span>
          <span class="shot-map">
            <iframe
              class="shot-frame"
              src="/minimap/mindmap.html"
              title="Live preview of the mindmap tool"
              loading="lazy"
              tabindex="-1"
              scrolling="no"></iframe>
          </span>
          <span class="shot-open" aria-hidden="true"
            ><svg class="i" aria-hidden="true"><use href="#d-play" /></svg>Open it</span
          >
        </a>
        {
          features.map((f) => (
            <article class:list={['cell', f.span]}>
              <svg class="i lg" aria-hidden="true">
                <use href={`#d-${f.icon}`} />
              </svg>
              <h2>{f.title}</h2>
              <p>{f.body}</p>
              {f.demo === 'status' && (
                <p class="demo tags" aria-hidden="true">
                  <b class="tag grey"><i></i>To do</b>
                  <b class="tag blue"><i></i>In progress</b>
                  <b class="tag rose"><i></i>Blocked</b>
                  <b class="tag lime"><i></i>Done</b>
                </p>
              )}
            </article>
          ))
        }
      </section>

    </main>

    <footer class="foot">
      <p class="foot-note">
        Minimap is just a quick side tool built while working. Download it and change it into
        whatever you need.
      </p>
      <div class="foot-row">
        <a href="/">← All works</a>
        <span>Icons by <a class="u" href="https://khushmeen.com/icons.html" target="_blank" rel="noopener">Khushmeen</a></span>
      </div>
    </footer>

    <style is:global>
      /* Site style system (see CLAUDE.md): strict black on white,
         Gochi Hand for headings, Onest 300 for body. The accent tokens below are
         only ever used inside the little product mock-ups. */
      :root {
        --paper: #ffffff;
        --ink: #0a0a0a;
        --ink-2: #6a6a6a;
        --ink-3: #9a9a9a;
        --rule: #ececec;
        --rule-2: #0a0a0a;
        --panel: #ffffff;
        --shadow: none;
        --sans: var(--font-body);
        --r: 14px;
        --a-grey: #8a8a8a;
        --a-blue: #2172ab;
        --a-pumpkin: #ea7b48;
        --a-lime: #9ac438;
        --a-aqua: #56a9a9;
        --a-rose: #f2405e;
        --a-iris: #7f56bd;
        --a-butter: #efbb43;
      }
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      body {
        font: var(--font-body-weight) 16px/1.6 var(--sans);
        color: var(--ink);
        background: var(--paper);
        -webkit-font-smoothing: antialiased;
      }
      a {
        color: inherit;
        text-decoration: none;
      }
      .i {
        width: 18px;
        height: 18px;
        fill: currentColor;
        flex: 0 0 auto;
      }
      .i.lg {
        width: 22px;
        height: 22px;
        color: var(--ink-2);
      }
      code {
        font: var(--font-ui-weight) 0.9em var(--sans);
        background: var(--rule);
        border-radius: 4px;
        padding: 1px 5px;
      }

      /* ---------- chrome ---------- */
      .top {
        position: sticky;
        top: 0;
        z-index: 10;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 14px clamp(16px, 4vw, 48px);
        background: color-mix(in srgb, var(--paper) 86%, transparent);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--rule);
      }
      /* same wordmark as the home page: light, tracked, uppercase */
      .back {
        display: inline-flex;
        align-items: center;
        font-size: 12px;
        font-weight: 300;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--ink);
      }
      .back:hover {
        color: var(--ink-2);
      }
      .top nav {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 14px;
      }
      .btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 15px;
        border: 1px solid var(--rule-2);
        border-radius: 999px;
        font-size: 14px;
        font-weight: 500;
        white-space: nowrap;
        transition: border-color 0.15s, background 0.15s, transform 0.15s;
      }
      /* the weight rides in the button so the page need not say it twice */
      .btn-sz {
        color: var(--ink-3);
        font-size: 12px;
        letter-spacing: 0.02em;
      }
      .btn:hover .btn-sz {
        color: inherit;
        opacity: 0.6;
      }
      .btn:hover {
        border-color: var(--ink);
        transform: translateY(-1px);
      }

      main {
        max-width: 1120px;
        margin-inline: auto;
        padding: 0 clamp(16px, 4vw, 48px) 80px;
      }

      /* ---------- hero ---------- */
      .hero {
        padding: clamp(48px, 9vw, 104px) 0 clamp(32px, 6vw, 56px);
        text-align: center;
      }
      h1 {
        font-family: var(--display);
        font-size: clamp(3.4rem, 14vw, 5rem);
        line-height: 1.04;
        letter-spacing: -0.02em;
        font-weight: 400;
        max-width: 19ch;
        margin-inline: auto;
      }
      h1 em {
        font-style: normal;
        color: var(--ink-2);
      }
      .lede {
        margin: 20px auto 0;
        max-width: 58ch;
        color: var(--ink-2);
        font-size: clamp(0.98rem, 1.6vw, 1.1rem);
      }

      /* ---------- mock ----------
         lives in the bento as a full-width first row, so the mock and the
         feature cells read as one grid rather than two stacked sections */
      .shot {
        position: relative;
        display: block;
        grid-column: 1 / -1;
        background: var(--panel);
        border-radius: var(--r);
        overflow: hidden;
      }
      /* the frame clips its own corners, so the drawn stroke sits just inside
         that edge — far enough in that the wobble is never cut off */
      .shot::after {
        content: '';
        position: absolute;
        inset: 3px;
        z-index: 3;
        border: 1.5px solid var(--ink);
        border-radius: calc(var(--r) - 3px);
        filter: url(#rough-b);
        pointer-events: none;
      }
      .shot-bar {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 11px 14px;
        border-bottom: 1px solid var(--rule);
      }
      .shot-bar i {
        flex: 0 0 auto;
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background: var(--rule-2);
      }
      /* the real app, running. It is a picture you can click, not a place to
         work: the frame takes no pointer or keyboard input, so the click
         always lands on the link that opens the tool in its own tab. */
      .shot-map {
        display: block;
        height: clamp(300px, 46vh, 440px);
        background: var(--paper);
      }
      /* the frame is rendered at a larger logical viewport and scaled back
         down, so the whole map fits inside the card instead of being cropped */
      .shot-frame {
        --z: 0.6;
        display: block;
        width: calc(100% / var(--z));
        height: calc(100% / var(--z));
        transform: scale(var(--z));
        transform-origin: 0 0;
        border: 0;
        pointer-events: none;
      }
      .shot-open {
        position: absolute;
        right: 14px;
        bottom: 14px;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 8px 14px;
        border-radius: 999px;
        background: var(--ink);
        color: var(--paper);
        font-size: 13px;
        opacity: 0;
        transform: translateY(4px);
        transition: opacity 0.18s, transform 0.18s;
      }
      .shot:hover .shot-open,
      .shot:focus-visible .shot-open {
        opacity: 1;
        transform: none;
      }
      .tag {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        border: 1px solid var(--rule-2);
        border-radius: 999px;
        padding: 1px 8px 1px 6px;
        font-size: 10.5px;
        font-weight: 400;
        color: var(--ink-2);
      }
      .tag i {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--tc, var(--ink-3));
      }
      .tag.grey {
        --tc: var(--a-grey);
      }
      .tag.blue {
        --tc: var(--a-blue);
      }
      .tag.rose {
        --tc: var(--a-rose);
      }
      .tag.lime {
        --tc: var(--a-lime);
      }

      /* ---------- bento ---------- */
      .bento {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        grid-auto-rows: minmax(188px, auto);
        gap: 12px;
      }
      .cell {
        position: relative;
        isolation: isolate;
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding: 20px;
        transition: color 0.18s;
      }
      /* the panel and its stroke live here, behind the content: the filter
         only ever distorts this box, never the words sitting on top of it */
      .cell::before {
        content: '';
        position: absolute;
        inset: 0;
        z-index: -1;
        background: var(--panel);
        border: 1.5px solid var(--ink);
        border-radius: var(--r);
        filter: url(#rough-a);
        transition: background 0.18s;
      }
      .cell:nth-child(3n)::before {
        filter: url(#rough-b);
      }
      .cell:nth-child(3n + 1)::before {
        filter: url(#rough-c);
      }
      .cell:hover {
        color: var(--paper);
      }
      .cell:hover::before {
        background: var(--ink);
      }
      .cell:hover p,
      .cell:hover .i.lg {
        color: var(--paper);
        opacity: 0.85;
      }
      .cell:hover .tag {
        background: transparent;
        border-color: rgba(255, 255, 255, 0.4);
        color: var(--paper);
      }
      .cell:hover .tag i {
        background: rgba(255, 255, 255, 0.6);
      }
      .cell:hover .tag.grey i {
        background: var(--a-grey);
      }
      .cell:hover .tag.blue i {
        background: var(--a-blue);
      }
      .cell:hover .tag.rose i {
        background: var(--a-rose);
      }
      .cell:hover .tag.lime i {
        background: var(--a-lime);
      }
      .cell h2 {
        font-family: var(--display);
        font-size: 1.3rem;
        /* Gochi Hand ships weight 400 only — 500 had the browser faking it */
        font-weight: 400;
        letter-spacing: -0.01em;
      }
      .cell p {
        font-size: 14px;
        color: var(--ink-2);
      }
      .cell.wide {
        grid-column: span 2;
      }
      .demo {
        margin-top: auto;
        padding-top: 14px;
      }
      .demo.tags {
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
      }

      .foot {
        max-width: 1120px;
        margin-inline: auto;
        padding: 22px clamp(16px, 4vw, 48px) 40px;
        border-top: 1px solid var(--rule);
        font-size: 13px;
        color: var(--ink-3);
      }
      /* an aside in the author's own voice, so it reads before the credits */
      .foot-note {
        margin-bottom: 14px;
        max-width: 62ch;
        line-height: 1.7;
        color: var(--ink-2);
      }
      .foot-row {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 10px;
      }
      .foot a:hover {
        color: var(--ink);
      }
      .foot .u a {
        text-decoration: underline;
        text-underline-offset: 2px;
      }

      /* ---------- responsive ---------- */
      @media (max-width: 900px) {
        .bento {
          grid-template-columns: repeat(2, 1fr);
        }
      }
      @media (max-width: 620px) {
        .bento {
          grid-template-columns: 1fr;
        }
        .cell.wide {
          grid-column: span 1;
        }
        .shot {
          grid-column: 1 / -1;
        }
        .top {
          padding: 12px 16px;
        }
        .back {
          font-size: 11px;
          letter-spacing: 0.06em;
        }
        .hero {
          text-align: left;
        }
        h1 {
          margin-inline: 0;
          max-width: none;
        }
        .lede {
          margin-inline: 0;
        }
        .shot-map {
          height: 260px;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        * {
          transition: none !important;
        }
      }
    </style>

    <script>
      // The preview frame is the real app, so it opens on whatever view is
      // stored — which is rarely centred. Ask it to fit the map to the frame,
      // then put the stored state back: the preview is a picture, and it must
      // not rewrite the pan/zoom of the visitor's own map.
      const frame = document.querySelector('.shot-frame');
      const KEY = 'mindmap.v1';
      // Read here, not on frame load: this page and the app share an origin, and
      // by the time the frame is up the app has already written its own view.
      let pristine = null;
      try {
        pristine = localStorage.getItem(KEY);
      } catch (e) {}

      function centreMap() {
        const w = frame && frame.contentWindow;
        if (!w || typeof w.fit !== 'function') return;
        w.fit();
        if (pristine == null) return;
        // Every fit — the app's own on boot, and ours — queues a write on a
        // 300ms debounce. Cancel the pending one inside the frame and put the
        // snapshot back, repeatedly while the frame settles: this preview must
        // never rewrite the pan/zoom of the visitor's own map.
        const guard = () => {
          try {
            w.eval('clearTimeout(saveT); saveT = null;');
          } catch (e) {}
          try {
            if (w.localStorage.getItem(KEY) !== pristine) w.localStorage.setItem(KEY, pristine);
          } catch (e) {}
        };
        guard();
        [300, 700, 1200, 2000].forEach((ms) => setTimeout(guard, ms));
      }

      if (frame) {
        frame.addEventListener('load', centreMap);
        // the frame may already be up by the time this runs
        if (frame.contentDocument && frame.contentDocument.readyState === 'complete') centreMap();

        let t;
        addEventListener('resize', () => {
          clearTimeout(t);
          t = setTimeout(centreMap, 150);
        });
      }
    </script>
  </body>
</html>
