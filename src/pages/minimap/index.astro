---
import { statSync } from 'node:fs';
import Fonts from '../../components/Fonts.astro';

// Read the download's real size at build time — it was hardcoded and went stale
// the first time the bundle changed.
const zipKB = Math.round(statSync('public/minimap/mindmap.zip').size / 1024);

// Landing page for Mindmap — the local-first mindmap tool.
// Deliberately NOT using BaseLayout/global.css: this page wears the product's
// own visual language (neutral B&W + the accent palette + system sans), so it
// reads as an extension of the tool rather than of the portfolio chrome.
const title = 'Mindmap — a local, keyboard-first mindmap tool';
const description =
  'One HTML file. No account, no server, no network. Keyboard-first mindmapping with markdown notes, cross-branch connections, status tags, and Map/Outline views.';
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const features = [
  // 4 singles + two wides = 8 column-units over 4 columns: two rows that tile
  // exactly, one wide closing the first row and one opening the second.
  { icon: 'tree',   title: 'Map or Outline', body: 'Two views of one tree.' },
  { icon: 'note',   title: 'Markdown notes', body: 'Styled as you type.' },
  { span: 'wide', icon: 'arrow-right', title: 'Connect and focus', body: 'Arrow-link any nodes \u2014 click one to dim everything else.' },
  { span: 'wide', icon: 'tag', title: 'Status on any node', body: 'To do, in progress, blocked, done \u2014 or your own.', demo: 'status' },
  { icon: 'shield', title: 'Local-first',    body: 'No account, no server, no network call.' },
  { icon: 'bot',    title: 'Let your agent build', body: 'One file it can read and edit. No MCP, no keys.' },
];
---

<!doctype html>
